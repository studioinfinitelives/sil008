# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# plan / working notes — never published
/private

# product art staged locally for review before it goes to the CDN.
# This repo is public and the artwork is not MIT-licensed (plan §6), so nothing
# under here may be committed. Once a file is on the CDN, delete it from
# `public/` and point the constant in `src/lib/cdn.ts` at the CDN URL.
/public/site_*
