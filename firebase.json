{
  "hosting": [
    {
      "target": "prod",
      "public": "out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/opengraph-image",
          "headers": [{ "key": "Content-Type", "value": "image/png" }]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "dev",
      "public": "out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/opengraph-image",
          "headers": [{ "key": "Content-Type", "value": "image/png" }]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
        }
      ]
    }
  ]
}
