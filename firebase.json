{
  "hosting": [
    {
      "target": "prod",
      "public": "out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/habisloth/privacy",
          "destination": "https://habisloth.app/privacy.html",
          "type": 301
        },
        {
          "source": "/habisloth/privacy.html",
          "destination": "https://habisloth.app/privacy.html",
          "type": 301
        },
        {
          "source": "/habisloth/terms",
          "destination": "https://habisloth.app/terms.html",
          "type": 301
        },
        {
          "source": "/habisloth/terms.html",
          "destination": "https://habisloth.app/terms.html",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "/_next/static/**",
          "redirects": [
            {
              "source": "/habisloth/privacy",
              "destination": "https://habisloth.app/privacy.html",
              "type": 301
            },
            {
              "source": "/habisloth/privacy.html",
              "destination": "https://habisloth.app/privacy.html",
              "type": 301
            },
            {
              "source": "/habisloth/terms",
              "destination": "https://habisloth.app/terms.html",
              "type": 301
            },
            {
              "source": "/habisloth/terms.html",
              "destination": "https://habisloth.app/terms.html",
              "type": 301
            }
          ],
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "dev",
      "public": "out",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
        }
      ]
    }
  ]
}
